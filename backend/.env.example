# ---------------------------------------------------------------------------
# UtiliPay backend configuration
# Copy to .env and fill in. Nothing here has a production-safe default.
# ---------------------------------------------------------------------------

# --- application ---
APP_ENV=development
PORT=8080
LOG_LEVEL=info
# Comma-separated. Must include the landing page and the app origin.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SHUTDOWN_TIMEOUT=15s

# --- database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=utilipay
# Must not be "disable" in production; the app refuses to start if it is.
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Kolkata
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
# Runs AutoMigrate + Seed on boot. Turn off once you manage schema separately.
DB_AUTO_MIGRATE=true

# --- auth ---
# REQUIRED. Generate with: openssl rand -base64 48
# Must be at least 32 characters in production.
JWT_SECRET=
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=720h
JWT_ISSUER=utilipay-api

# --- file storage ---
# Where retailer KYC uploads are written.
#
# These are PAN and Aadhaar scans. The directory MUST NOT be served by a web
# server or reverse proxy: files are streamed only through an authenticated
# handler that checks ownership. On a multi-instance deployment point this at
# shared storage, otherwise a retailer's document will be missing on whichever
# instance did not receive the upload.
UPLOAD_DIR=./data/uploads
# Per-file limit in bytes. Default 5 MB.
MAX_UPLOAD_BYTES=5242880

# ---------------------------------------------------------------------------
# AEPS — Excisoft
# Source: AEPS/api_doc.md
# ---------------------------------------------------------------------------
AEPS_ENABLED=true
AEPS_BASE_URL=https://apidev.excisofttech.com
# Issued by Excisoft. Never commit the real value.
AEPS_API_KEY=
# Where the provider returns the retailer after hosted KYC.
AEPS_CALLBACK_URL=http://localhost:8080/api/v1/webhooks/aeps/onboard
AEPS_TIMEOUT=45s

# ---------------------------------------------------------------------------
# Bharat Connect — MobiKwik
# Source: bharat_connect/encryption.md, recharge&billpayment_api_doc.md
# ---------------------------------------------------------------------------
BC_ENABLED=true
BC_BASE_URL=https://alpha3.mobikwik.com
# Issued by MobiKwik. These are live credentials: keep them in .env only, which is
# gitignored. Anything committed here ends up in the repository history forever,
# and a client secret cannot be un-published.
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_KEY_VERSION=1.0
# MobiKwik's RSA public key (SPKI, base64 DER). Not secret in itself, but supplied
# alongside the credentials, so it is filled in per environment.
BC_PUBLIC_KEY_BASE64=
# Supplied by the provider after UAT sign-off.
BC_AGENT_ID=
BC_TENANT_ID=
BC_TIMEOUT=45s
# Refresh this far before the 24h token actually expires.
BC_TOKEN_SAFETY_WINDOW=30m

# Cipher suite for the request envelope, per the specification's
# "Steps for Encryption" section: AES-256-GCM payload, RSA-2048 PKCS1Padding
# key wrap, 128-bit GCM tag, Base64 everywhere. Do not change these unless the
# provider says so.
#   BC_AES_MODE:     cbc | gcm                              (spec: gcm)
#   BC_RSA_PADDING:  pkcs1v15 | oaep-sha1 | oaep-sha256      (spec: pkcs1v15)
BC_AES_MODE=gcm
BC_RSA_PADDING=pkcs1v15

# GCM IV length in bytes.
#
# CONFIRMED as 12 by a live call to the provider's UAT environment: a Balance
# Check sent with a 12-byte IV was decrypted and answered successfully. The
# specification's prose and Java sample claim 16 bytes; that is incorrect, and
# its own captured sample requests (16-character base64 IVs) were right.
# Do not change this unless the provider changes the requirement.
BC_GCM_IV_SIZE=12

# ---------------------------------------------------------------------------
# Reconciliation worker (UAT checklist items 15-17)
# ---------------------------------------------------------------------------
RECON_ENABLED=true
RECON_INTERVAL=60s
RECON_MAX_ATTEMPTS=8
RECON_BATCH_SIZE=100
