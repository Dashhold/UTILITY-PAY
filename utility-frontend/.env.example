# Where the backend API lives.
#
# Leave EMPTY for same-origin, which is how production runs: nginx serves this app
# and proxies /api to the backend on utilipayhub.com, so there is no cross-origin
# request and no CORS preflight.
#
# Set an absolute URL only when the API is genuinely on another origin. If you do,
# that origin must appear in the backend's ALLOWED_ORIGINS or the browser blocks
# every request.
VITE_API_URL=

# The sub-path this app is served under. Must end with a slash.
#
# utilipayhub.com serves the marketing site at the root, so the dashboard is
# mounted at /app/. Set to / if you move the app to its own subdomain.
APP_BASE_PATH=/app/

# Development only: where `npm run dev` proxies /api to.
VITE_DEV_API_TARGET=http://localhost:8099
