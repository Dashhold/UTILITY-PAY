# Frontend Application URL
# This is the URL for the main utility-frontend application (Vite + React)
# In development, it runs on port 5173
# In production, update this to your production domain
NEXT_PUBLIC_APP_URL=http://localhost:5173

# Login page URL (defaults to APP_URL/login if not set)
NEXT_PUBLIC_APP_LOGIN_URL=http://localhost:5173/login

# Register page URL (defaults to APP_URL/login if not set)
# Note: Registration is handled through the login page in utility-frontend
NEXT_PUBLIC_APP_REGISTER_URL=http://localhost:5173/login
