# ---------------------------------------------------------------------------
# UtiliPay Hub — deployment configuration
#
# Copy to .env beside docker-compose.yml and fill in. Nothing here has a
# production-safe default: the stack refuses to start without DB_PASSWORD and
# JWT_SECRET, and refuses to run with local file storage in production.
#
#   cp .env.example .env
#   docker compose --env-file .env up -d --build
# ---------------------------------------------------------------------------

# --- application ---
APP_ENV=production
LOG_LEVEL=info

# Only consulted if the dashboard is moved to a different origin from the API.
# In the default single-domain topology every request is same-origin.
ALLOWED_ORIGINS=https://utilipayhub.com,https://www.utilipayhub.com

# --- database ---
DB_USER=utilipay
# REQUIRED. Generate with: openssl rand -base64 32
DB_PASSWORD=
DB_NAME=utilipay
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Kolkata
# Runs AutoMigrate and the seed on boot. Both are idempotent.
DB_AUTO_MIGRATE=true

# --- auth ---
# REQUIRED. Generate with: openssl rand -base64 48
# Rotating this invalidates every issued token, signing all users out.
JWT_SECRET=
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=720h

# --- KYC document storage ---
#
# s3 for any real deployment. The container filesystem is discarded on every
# release, so 'local' loses every uploaded PAN and Aadhaar scan. The API refuses
# to start with STORAGE_DRIVER=local when APP_ENV=production.
#
# The bucket MUST block public access. Documents are streamed only through an
# authenticated API endpoint that checks ownership; nothing is ever served by URL.
STORAGE_DRIVER=s3
S3_BUCKET=utilipayhub-kyc
S3_REGION=ap-south-1
S3_PREFIX=kyc

# Leave the keys empty on EC2 and attach an IAM instance role granting
# s3:PutObject, s3:GetObject and s3:DeleteObject on the bucket, plus
# s3:ListBucket for the startup reachability check. The SDK finds the role
# automatically, and there are no long-lived keys to leak.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# For an S3-compatible service such as MinIO. Leave empty for AWS.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Per-file upload limit in bytes. Default 5 MB.
MAX_UPLOAD_BYTES=5242880

# --- bootstrap logins ---
#
# Created only if absent, so a password changed in the app is never reset by a
# redeploy. Change these before the first boot: after the accounts exist, editing
# them here has no effect and you must change the password in the app.
#
# Note that neither default password contains a digit, so the app's own
# change-password form will not accept the same value back. Pick something with a
# digit if you intend to re-enter it there.
SEED_ADMIN_NAME=UtiliPay Hub Admin
SEED_ADMIN_EMAIL=adminutilihub@gmail.com
SEED_ADMIN_PASSWORD=utilihub@admin
SEED_RETAILER_EMAIL=retailer.demo@gmail.com
SEED_RETAILER_PASSWORD=demo@retailer

# --- dashboard build ---
# Compiled into the bundle, so a change needs `docker compose build app`.
# Empty VITE_API_URL means same-origin, which is what the nginx routing provides.
APP_BASE_PATH=/app/
VITE_API_URL=

# ---------------------------------------------------------------------------
# AEPS — Excisoft
# ---------------------------------------------------------------------------
AEPS_ENABLED=true
AEPS_BASE_URL=https://apidev.excisofttech.com
# Issued by Excisoft. Fill in on the server; never commit the real value.
AEPS_API_KEY=
AEPS_CALLBACK_URL=https://utilipayhub.com/api/v1/webhooks/aeps/onboard
AEPS_TIMEOUT=45s

# ---------------------------------------------------------------------------
# Bharat Connect — MobiKwik
# ---------------------------------------------------------------------------
BC_ENABLED=true
BC_BASE_URL=https://alpha3.mobikwik.com
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_PUBLIC_KEY_BASE64=
BC_KEY_VERSION=1.0

# Supplied by MobiKwik after UAT sign-off. Every transactional payload requires
# it, so balance, validation, view-bill, payment and status all fail without it.
BC_AGENT_ID=
BC_TENANT_ID=

BC_AES_MODE=gcm
BC_RSA_PADDING=pkcs1v15

# 12, confirmed by a successful live Balance Check against UAT. The
# specification's prose and Java sample claim 16 and are wrong; its own captured
# sample requests agree with 12. Do not change without the provider saying so.
BC_GCM_IV_SIZE=12

BC_TIMEOUT=45s
BC_TOKEN_SAFETY_WINDOW=30m

# ---------------------------------------------------------------------------
# Reconciliation worker (UAT checklist items 15-17)
# ---------------------------------------------------------------------------
RECON_ENABLED=true
RECON_INTERVAL=60s
RECON_MAX_ATTEMPTS=8

# ---------------------------------------------------------------------------
# TLS
# ---------------------------------------------------------------------------
# Used by deploy/init-letsencrypt.sh.
CERTBOT_DOMAINS=utilipayhub.com,www.utilipayhub.com
CERTBOT_EMAIL=
